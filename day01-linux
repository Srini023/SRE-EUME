Task B — Inspect processes
ps aux --sort=-%cpu | head
pstree -p

Task C — Inspect cgroups
systemd-cgls
# View the cgroup tree hierarchy attached to your active shell session
cat /proc/$$/cgroup
# Check system-wide cgroup performance mounts
mount | grep cgroup

Task D — Inspect namespaces

# List all active system namespaces and their tracking IDs
lsns
# View the symlinked namespace descriptors mapped directly to your current shell process
ls -la /proc/$$/ns/
nsenter --target <PID> --mount --uts --ipc --net --pid

